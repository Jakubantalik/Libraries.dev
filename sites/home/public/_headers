# Cloudflare Pages headers.
#
# The shared scripts and stylesheets are referenced by a fixed path (no
# content hash), so the default 4-hour browser cache meant a deploy could
# leave visitors on the previous pro-client.js / site.js until it expired.
# Ask the browser to revalidate every time; the ETag keeps it a cheap 304.
/assets/site.js
  Cache-Control: public, max-age=0, must-revalidate
/assets/pro-client.js
  Cache-Control: public, max-age=0, must-revalidate
/assets/site.css
  Cache-Control: public, max-age=0, must-revalidate
/assets/playground.css
  Cache-Control: public, max-age=0, must-revalidate
/assets/examples.css
  Cache-Control: public, max-age=0, must-revalidate

# Agent-facing docs are plain text and markdown; say so, so agents and
# crawlers don't treat them as HTML.
/llms.txt
  Content-Type: text/plain; charset=utf-8
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
/llms/*
  Content-Type: text/markdown; charset=utf-8

# The Magnet Bridge app for the Magnetic UI live demo: an Android package,
# downloaded (not opened) and always the latest build.
/downloads/*.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment
  Cache-Control: public, max-age=0, must-revalidate
/downloads/*.mfxl
  Content-Type: application/octet-stream
  Content-Disposition: attachment
  Cache-Control: public, max-age=0, must-revalidate
