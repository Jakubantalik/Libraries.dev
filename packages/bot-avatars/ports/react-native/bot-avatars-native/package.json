    "src"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bot-avatars": "file:../../.."
  },
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.78.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-worklets": ">=0.7.0"
  },
  "devDependencies": {
    "@shopify/react-native-skia": "^2.12.0",
    "@types/react": "~19.1.0",
    "react": "^19.1.0",
    "react-native": "^0.81.0",
    "react-native-reanimated": "^4.1.0",
    "react-native-worklets": "^0.8.0",
    "typescript": "^5.8.0"
  },
  "keywords": [
    "react-native",
    "skia",
