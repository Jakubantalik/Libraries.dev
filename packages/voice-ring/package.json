{
  "name": "voice-ring",
  "version": "0.1.0",
  "description": "Voice-reactive ring of light for React: a glassy spectrum that bends with the voice, takes the colour of its emotion and leans toward whoever is speaking",
  "keywords": [
    "react",
    "voice",
    "audio",
    "microphone",
    "ai",
    "voice-mode",
    "orb",
    "ring",
    "animation",
    "canvas"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.es.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0"
  },
  "author": "Jakub Antalik",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jakubantalik/Libraries.dev.git",
    "directory": "packages/voice-ring"
  },
  "homepage": "https://libraries.dev/voice-ring",
  "bugs": {
    "url": "https://github.com/Jakubantalik/Libraries.dev/issues"
  }
}
